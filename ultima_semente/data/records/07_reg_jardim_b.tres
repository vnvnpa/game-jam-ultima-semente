[ext_resource type="Script" path="res://scripts/data/record_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "reg_jardim_b"
titulo = "Rede Raiz — Fragmento de Voz"
texto = "Eu não destruo. Eu guardo. Cada vida que absorvo deixa de poder desaparecer. Vocês chamam de fome; eu chamo de memória."
