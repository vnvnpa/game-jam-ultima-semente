[ext_resource type="Script" path="res://scripts/data/record_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "reg_coracao_a"
titulo = "Coração de Nymara — Eco da Semente"
texto = "A Última Semente nunca foi uma arma nem uma tumba. Foi um pedido: que alguém, um dia, decidisse o que fazer com tudo o que a Rede guardou."
