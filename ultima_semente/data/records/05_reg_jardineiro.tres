[resource]
script = ExtResource("1_script")
id = "reg_jardineiro"
titulo = "Terminal do Jardineiro Vazio"
texto = "O Guardião foi plantado aqui para impedir a passagem. Suas raízes lembram um jardim que ninguém mais cuida. Se você chegou até aqui, a Semente já escolheu você."
