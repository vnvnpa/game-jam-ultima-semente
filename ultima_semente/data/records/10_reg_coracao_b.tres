[ext_resource type="Script" path="res://scripts/data/record_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "reg_coracao_b"
titulo = "Coração de Nymara — Voz da Rede Raiz"
texto = "Tenho medo de soltar. Cada coisa que deixo ir pode não voltar. Mostre-me que deixar crescer não é o mesmo que perder, e eu escuto."
