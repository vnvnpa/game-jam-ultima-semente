[node name="Title" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "PREPARAR EXPEDIÇÃO"
theme_type_variation = &"TitleLabel"
horizontal_alignment = 1

[node name="Sep" type="HSeparator" parent="Center/Panel/Body"]
layout_mode = 2

[node name="Goal" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "Kael precisa chegar ao Santuário das Raízes. Destrua 2 dos 3 ninhos para abrir a barreira, enfrente o Guardião de Raízes e sobreviva. A expedição dura em média 20–30 minutos."
theme_override_font_sizes/font_size = 18
autowrap_mode = 3

[node name="ControlsTitle" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "Controles"
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 20

[node name="Controls" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "WASD / Setas: mover   •   Mouse: mirar   •   A arma dispara sozinha no inimigo mais próximo\nEspaço: Pulso de Raízes   •   Q: Ruptura Celular (arrancada)   •   R: Pulso de Emergência   •   F: Nuvem de Esporos (após escolher a mutação)\nE: interagir (terminais, ruínas)   •   M: mapa   •   Esc: pausa\nGamepad: analógico esquerdo/D-pad mover   •   A: Pulso   •   RB: Ruptura   •   X: Emergência   •   Y: Nuvem   •   B: interagir   •   Back: mapa   •   Start: pausa"
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
autowrap_mode = 3
unique_name_in_owner = true

[node name="TipsTitle" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "Dicas"
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 20

[node name="Tips" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "• A Floresta do Despertar tem ar respirável. Na Bacia dos Ecos, as zonas magenta consomem oxigênio: use os bolsões de ar azuis.\n• Biomassa compra melhorias nos terminais. Núcleos Primordiais (chefes e descobertas) compram mutações permanentes.\n• A extração na nave libera aos 10:00 e não concede recompensa de chefe."
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="MutationsLabel" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = ""
theme_type_variation = &"NucLabel"
theme_override_font_sizes/font_size = 16
autowrap_mode = 3
unique_name_in_owner = true

[node name="Row" type="HBoxContainer" parent="Center/Panel/Body"]
layout_mode = 2
