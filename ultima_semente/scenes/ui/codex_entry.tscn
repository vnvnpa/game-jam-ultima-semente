[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://ui/game_theme.tres" id="1_game_theme"]
[ext_resource type="Script" path="res://scripts/ui/codex_entry.gd" id="2_codex_entr"]

[node name="CodexEntry" type="VBoxContainer"]
theme = ExtResource("1_game_theme")
script = ExtResource("2_codex_entr")

[node name="EntryTitle" type="Label" parent="."]
layout_mode = 2
text = "Título"
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 20
unique_name_in_owner = true

[node name="EntryBody" type="Label" parent="."]
layout_mode = 2
text = ""
theme_override_font_sizes/font_size = 15
autowrap_mode = 3
unique_name_in_owner = true
