unique_name_in_owner = true

[node name="Thanks" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "Obrigado por jogar e ajudar Kael a descobrir o destino de Nymara."
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 18
horizontal_alignment = 1
autowrap_mode = 3

[node name="Sep2" type="HSeparator" parent="Center/Panel/Body"]
layout_mode = 2

[node name="Ask" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "Quer ajudar a financiar um próximo projeto?"
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1

[node name="SupportText" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
text = "Se você gostou do jogo, poderá apoiar voluntariamente o próximo projeto pela página oficial de Projeto: Última Semente no itch.io.\n\nBaixar, concluir o jogo e assistir aos créditos nunca depende de pagar ou doar. Obrigado por fazer parte desta jornada."
theme_override_font_sizes/font_size = 17
horizontal_alignment = 1
autowrap_mode = 3

[node name="SupportRow" type="CenterContainer" parent="Center/Panel/Body"]
layout_mode = 2

[node name="SupportButton" type="Button" parent="Center/Panel/Body/SupportRow"]
layout_mode = 2
custom_minimum_size = Vector2(240.0, 48.0)
focus_mode = 0
text = "Apoiar o projeto"
unique_name_in_owner = true

[node name="ContactLabel" type="Label" parent="Center/Panel/Body"]
layout_mode = 2
