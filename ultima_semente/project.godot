; Engine configuration file.
; Projeto: Última Semente — Godot 4.7.x (GDScript, renderizador Compatibility)

config_version=5

[application]

config/name="Projeto: Última Semente"
config/description="Jogo 2D top-down de ação, sobrevivência e evolução biológica."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

