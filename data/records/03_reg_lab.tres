[ext_resource type="Script" path="res://scripts/data/record_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = "reg_lab"
titulo = "Laboratório Submerso — Registro 14"
texto = "A rede subterrânea começou a nos imitar. Ela não ataca: ela copia. Cada cópia perde um pouco do que era. Alguém selou as comportas. Não sei se foi para nos proteger ou para nos prender."
